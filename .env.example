APP_NAME=AurexAPI
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aurex
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars
JWT_EXPIRY=3600

CORS_ALLOWED_ORIGINS=http://localhost

LOG_PATH=logs/app.log
LOG_LEVEL=debug

RATE_LIMIT=60
RATE_LIMIT_WINDOW=60
